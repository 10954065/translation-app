# Flask
FLASK_ENV=development
SECRET_KEY=change-this-to-a-random-secret-in-production
HOST=0.0.0.0
PORT=5000

# CORS - comma separated list of allowed origins
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Translation
TRANSLATION_PROVIDER=google
TRANSLATION_TIMEOUT_SECONDS=6
TRANSLATION_MAX_RETRIES=2
# Optional but recommended: DeepL free API key (deepl.com/pro-api). Tried
# first when set, since it is authenticated and not subject to the shared-IP
# rate limiting that affects Google/MyMemory. Leave blank to skip.
DEEPL_API_KEY=

# PDF uploads
MAX_PDF_SIZE_MB=10
PDF_UPLOAD_DIR=uploads

# Demo mode - never true in production
DEMO_MODE=false
